{
  "name": "Dialog × Microsoft Foundry Agents Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {}
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && cp -n .env.example .env",
  "forwardPorts": [9999, 8090],
  "portsAttributes": {
    "9999": { "label": "A2A Roaming agent" },
    "8090": { "label": "Agent Framework DevUI" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-windows-ai-studio.windows-ai-studio", "humao.rest-client"]
    }
  },
  "hostRequirements": { "cpus": 2 }
}

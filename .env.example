# Copy to .env  (cp .env.example .env) and fill in. Never commit .env.
FOUNDRY_PROJECT_ENDPOINT=<https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT>
FOUNDRY_MODEL=<your chat model deployment name, e.g. gpt-5.4-mini>
PARTICIPANT_ALIAS=<your short name, e.g. amila-a>

# Lab 2 Part B — shared Foundry IQ knowledge base (from the facilitators)
FOUNDRY_IQ_MCP_URL=
FOUNDRY_IQ_CONNECTION_ID=

# Lab 4 — another team's A2A agent (default: your own on localhost)
A2A_AGENT_HOST=http://localhost:9999

# Lab 6 — printed at the end of Lab 5 --eval
EVAL_ID=

# Lab 7 — distillation
TEACHER_MODEL=
STUDENT_BASE_MODEL=gpt-4.1-mini
FT_TRAINING_TYPE=GlobalStandard
